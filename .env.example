# ============================================================
# Environment Variables Template – copy to .env and fill values
# ============================================================

# HTTP port the server listens on
PORT=8080

# MongoDB connection URI
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Name of the MongoDB database
DB_NAME=ai_camp

# Secret key required to access admin endpoints (/api/admin/*)
# Choose a long random string – treat it like a password!
ADMIN_SECRET=change_me_to_a_strong_secret_key

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev:   http://localhost:5173
# Production:  https://your-site.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
